<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>fuse-examples</artifactId>
        <groupId>com.yangdb</groupId>
        <version>0.9.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>fuse-domain-dragons-ext</artifactId>

    <properties>
        <swagger-ui.playground.version>5.35.1</swagger-ui.playground.version>
        <checkstyle.skip>true</checkstyle.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.yangdb</groupId>
            <artifactId>fuse-asg</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yangdb</groupId>
            <artifactId>fuse-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yangdb</groupId>
            <artifactId>fuse-dv-epb</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yangdb</groupId>
            <artifactId>fuse-dv-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yangdb</groupId>
            <artifactId>fuse-dv-unipop</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yangdb</groupId>
            <artifactId>fuse-dv-asg</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yangdb</groupId>
            <artifactId>fuse-dv-gta</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yangdb</groupId>
            <artifactId>fuse-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yangdb</groupId>
            <artifactId>fuse-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yangdb</groupId>
            <artifactId>fuse-dv-stat</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yangdb</groupId>
            <artifactId>fuse-test-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yangdb</groupId>
            <artifactId>fuse-geojson</artifactId>
        </dependency>
        <!-- jooby MVC -->
        <dependency>
            <groupId>org.jooby</groupId>
            <artifactId>jooby</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.internetitem</groupId>
            <artifactId>logback-elasticsearch-appender</artifactId>
        </dependency>

        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
            <version>2.4.0</version>
        </dependency>

        <!--Tests-->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>uk.co.datumedge</groupId>
            <artifactId>hamcrest-json</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.yangdb</groupId>
            <artifactId>fuse-service</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.yangdb</groupId>
            <artifactId>fuse-model</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- the tutorial data and ontology, bundled for POST /fuse/dragons/tutorial/load (single copy in the repo) -->
            <resource>
                <directory>${project.basedir}/../../../docs/tutorial/sample/dragons/csv</directory>
                <targetPath>dragons/tutorial/csv</targetPath>
                <includes><include>*.csv</include></includes>
                <excludes><exclude>._*</exclude></excludes>
            </resource>
            <resource>
                <directory>${project.basedir}/../../../distribution/resources/assembly/Dragons/ontology</directory>
                <targetPath>dragons/tutorial</targetPath>
                <includes><include>Dragons.json</include></includes>
            </resource>
        </resources>
        <plugins>
            <!--
              Swagger UI 5 for the Dragons playground page (/dragons/swagger). Unpacked into this jar under
              dragons/playground/ui instead of being a dependency: as a dependency, Maven would replace the swagger-ui
              3.17.1 webjar that jooby-apitool needs for the generated /swagger, and the service would fail to start.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>unpack-playground-swagger-ui</id>
                        <phase>process-resources</phase>
                        <goals><goal>unpack</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.webjars</groupId>
                                    <artifactId>swagger-ui</artifactId>
                                    <version>${swagger-ui.playground.version}</version>
                                    <includes>META-INF/resources/webjars/swagger-ui/${swagger-ui.playground.version}/swagger-ui-bundle.js,META-INF/resources/webjars/swagger-ui/${swagger-ui.playground.version}/swagger-ui.css</includes>
                                    <outputDirectory>${project.build.outputDirectory}/dragons/playground/ui</outputDirectory>
                                    <fileMappers>
                                        <org.codehaus.plexus.components.io.filemappers.FlattenFileMapper/>
                                    </fileMappers>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>